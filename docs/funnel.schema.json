{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "subAgent": {
      "type": "string"
    },
    "brief": {
      "type": "boolean"
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "slack"
              },
              "name": {
                "type": "string"
              },
              "botToken": {
                "type": "string"
              },
              "appToken": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "properties": {
                  "botToken": {
                    "type": "string"
                  },
                  "appToken": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "discord"
              },
              "name": {
                "type": "string"
              },
              "botToken": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "properties": {
                  "botToken": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "gh"
              },
              "name": {
                "type": "string"
              },
              "pollInterval": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "schedule"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "channel"
  ],
  "additionalProperties": false,
  "title": "Funnel per-repo launch config",
  "description": "Used by `fnl claude` when no --profile / --channel is given. Declares the channel to subscribe to, optional sub-agent and brief flag, environment variables to layer under process.env, and optional connectors to materialize into ~/.funnel/settings.json on launch."
}

