{
  "name": "@interactive-inc/claude-funnel",
  "version": "0.73.2",
  "description": "Connection library for routing external events to channel subscribers. Host-owned configuration, runtime and persistence.",
  "keywords": [
    "connections",
    "discord",
    "events",
    "github",
    "slack",
    "websocket"
  ],
  "homepage": "https://github.com/interactive-inc/open-claude-funnel#readme",
  "bugs": {
    "url": "https://github.com/interactive-inc/open-claude-funnel/issues"
  },
  "license": "MIT",
  "author": "Interactive Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interactive-inc/open-claude-funnel.git"
  },
  "files": [
    "dist/**/*",
    ".docs/embedding.md",
    ".docs/websocket-delivery.md",
    ".docs/design.md",
    ".docs/migration-0.72.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js",
      "default": "./dist/gateway.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js",
      "default": "./dist/claude.js"
    },
    "./channel": {
      "types": "./dist/channel.d.ts",
      "import": "./dist/channel.js",
      "default": "./dist/channel.js"
    },
    "./event-log": {
      "types": "./dist/event-log.d.ts",
      "import": "./dist/event-log.js",
      "default": "./dist/event-log.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "default": "./dist/logger.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    },
    "./connectors/slack": {
      "types": "./dist/connectors/slack.d.ts",
      "import": "./dist/connectors/slack.js",
      "default": "./dist/connectors/slack.js"
    },
    "./connectors/discord": {
      "types": "./dist/connectors/discord.d.ts",
      "import": "./dist/connectors/discord.js",
      "default": "./dist/connectors/discord.js"
    },
    "./connectors/gh": {
      "types": "./dist/connectors/gh.d.ts",
      "import": "./dist/connectors/gh.js",
      "default": "./dist/connectors/gh.js"
    },
    "./connectors/schedule": {
      "types": "./dist/connectors/schedule.d.ts",
      "import": "./dist/connectors/schedule.js",
      "default": "./dist/connectors/schedule.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "build": "vp pack",
    "check:package": "node scripts/check-package.mjs",
    "lint": "vp lint"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@interactive-inc/flume": "^0.11.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "4.1.1",
    "ip-address": "10.3.1",
    "nanoid": "3.3.20",
    "postcss": "8.5.23",
    "qs": "6.15.3",
    "source-map-js": "1.2.2",
    "tinypool": "2.2.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5",
    "ws": "8.21.1",
    "zod": "^4.6.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "warn"
    }
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  }
}
