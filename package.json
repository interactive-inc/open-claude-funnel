{
  "name": "@interactive-inc/claude-funnel",
  "version": "0.8.1",
  "description": "Hub CLI that routes external events (Slack / GitHub / Discord) to Claude Code agents through subscription channels over MCP.",
  "keywords": [
    "bun",
    "claude",
    "claude-code",
    "cli",
    "discord",
    "github",
    "mcp",
    "slack"
  ],
  "homepage": "https://github.com/interactive-inc/open-claude-funnel#readme",
  "bugs": {
    "url": "https://github.com/interactive-inc/open-claude-funnel/issues"
  },
  "license": "MIT",
  "author": "Interactive Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interactive-inc/open-claude-funnel.git"
  },
  "bin": {
    "fnl": "./dist/bin.js",
    "funnel": "./dist/bin.js"
  },
  "files": [
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "!lib/**/*.test.ts",
    "!lib/**/*.test.tsx",
    "!lib/**/*.bun-test.ts",
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:lib && bun run build:bin && bun run build:types && bun run build:resolve-aliases",
    "build:lib": "bun scripts/build-lib.ts",
    "build:bin": "bun build lib/bin.ts lib/gateway/daemon.ts --target=bun --outdir dist --minify",
    "build:types": "tsc -p tsconfig.build.json",
    "build:resolve-aliases": "bun scripts/resolve-d-ts-aliases.ts",
    "prepare": "bun run build"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bin": "./dist/bin.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "^0.2.2",
    "@opentui/react": "^0.2.2",
    "@slack/bolt": "^4.7.2",
    "@slack/web-api": "^7.15.1",
    "@types/react": "^19.2.14",
    "discord.js": "^14.26.4",
    "hono": "^4.12.16",
    "react": "^19.2.5",
    "yaml": "^2.8.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@typescript/native-preview": "^7.0.0-dev.20260503.1",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.5"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
