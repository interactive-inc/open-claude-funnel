{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "channels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "connectors": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "slack"
                    },
                    "name": {
                      "type": "string"
                    },
                    "minify": {
                      "type": "boolean"
                    }
                  },
                  "required": ["type", "name"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "discord"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "name"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "gh"
                    },
                    "name": {
                      "type": "string"
                    },
                    "pollInterval": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["type", "name"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "schedule"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "name"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "resume": {
            "type": "boolean"
          }
        },
        "required": ["name", "channel"],
        "additionalProperties": false
      }
    }
  },
  "required": ["channels"],
  "additionalProperties": false,
  "title": "Funnel per-repo launch config",
  "description": "Used by `fnl claude` to declare channels (transport: connectors to materialize into ~/.funnel/settings.json on launch) and profiles (launch recipe: options / env / resume) bound to those channels."
}
